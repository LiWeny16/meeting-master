{
  "name": "meeting-master",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --maxWorkers=1 && node --test --test-concurrency=1 scripts/cdp-bridge-security.test.mjs scripts/cdp-agent-bridge.test.mjs scripts/agent-deepseek.test.mjs scripts/agent-tool-budget.test.mjs scripts/agent-compaction.test.mjs scripts/agent-eval.test.mjs",
    "agent:eval": "node scripts/agent-eval.mjs",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "tauri:dev": "node scripts/dev-tauri.mjs",
    "tauri:build": "tauri build",
    "cdp:bridge": "node scripts/cdp-agent-bridge.mjs --http",
    "native:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml",
    "agent:stage": "node scripts/stage-agent-runtime.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.30",
    "@assistant-ui/react": "^0.15.30",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lobehub/icons-static-svg": "1.95.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^14.1.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
